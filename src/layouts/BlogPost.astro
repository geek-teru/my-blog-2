---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Tags from '../components/Tags.astro';

// about ページなどコレクション外からも使われるため、headings は任意にしておく
type Props = CollectionEntry<'blog'>['data'] & { headings?: MarkdownHeading[] };

const { title, description, pubDate, updatedDate, tags = [], heroImage, headings } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={title} description={description} type="article" />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="post-head">
					<div class="meta">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="updated">
									最終更新 <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
					<h1>{title}</h1>
					<Tags tags={tags} />
				</header>

				{
					heroImage && (
						<figure class="hero">
							<Image width={1200} height={600} src={heroImage} alt="" />
						</figure>
					)
				}

				<TableOfContents headings={headings} />

				<div class="prose">
					<slot />
				</div>
			</article>

			<nav class="post-foot">
				<a href="/blog">← 記事一覧へ</a>
			</nav>
		</main>
		<Footer />
	</body>
</html>

<style>
	/*
	  記事の頭は左揃えにしている。雛形は中央寄せだったが、日本語の長いタイトルは
	  3行以上に折り返すことがあり、中央寄せだと行頭が揃わず読み出しにくい。
	*/
	.post-head {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.8rem;
		margin-bottom: 0.5rem;
		color: rgb(var(--gray));
		font-size: 0.82rem;
		line-height: 1.6;
	}
	.post-head h1 {
		margin-bottom: 0.6rem;
	}
	.hero {
		margin: 0 0 2rem;
	}
	.hero :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	.post-foot {
		margin-top: 4rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgb(var(--gray-light));
		font-size: 0.92rem;
	}
	.post-foot a {
		text-decoration: none;
	}
	.post-foot a:hover {
		text-decoration: underline;
	}
</style>
