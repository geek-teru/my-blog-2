---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 5);
const hasMore = posts.length > latest.length;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>{SITE_TITLE}</h1>
				<p>
					手を動かして学んだことを、そのまま記事にしていくブログです。
					Next.js / Supabase / Claude Code まわりの検証ログが中心です。
				</p>
			</section>

			<section>
				<h2 class="section-title">最近の記事</h2>
				<PostList posts={latest} />
				{
					hasMore && (
						<p class="more">
							<a href="/blog">記事の一覧を見る →</a>
						</p>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/*
	  トップは「自己紹介 + 最近の記事」にした。記事一覧と分けて置くと、
	  記事が数本の段階ではトップに実質的な中身が無くなる。
	*/
	.intro {
		padding-bottom: 2.5rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.intro h1 {
		margin-bottom: 0.8rem;
	}
	.intro p {
		margin: 0;
		color: rgb(var(--gray));
	}
	.section-title {
		margin: 2.5rem 0 1.5rem;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: rgb(var(--gray));
	}
	.more {
		margin: 1.8rem 0 0;
		font-size: 0.92rem;
	}
	.more a {
		text-decoration: none;
	}
	.more a:hover {
		text-decoration: underline;
	}
</style>
