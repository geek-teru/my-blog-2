---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/profile">Profile</HeaderLink>
			<HeaderLink href="/career">Career</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--navy);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		width: var(--measure);
		max-width: calc(100% - 2.5rem);
		margin: 0 auto;
		padding: 0.9rem 0;
	}
	.brand {
		color: var(--header-fg);
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: 0.01em;
		text-decoration: none;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.5rem 1.1rem;
		font-size: 0.9rem;
	}
</style>
