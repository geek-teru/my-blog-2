---
/**
 * トップの入口カード。ヘッダーのナビと同じ行き先を、
 * 本文の中にもう一度置いて「次にどこを見ればいいか」を示す。
 */
const cards = [
	{ href: '/profile', title: 'Profile', text: '経歴とスキル' },
	{ href: '/career', title: 'Career', text: 'これまでの案件と時期' },
	{ href: '/blog', title: 'Blog', text: '学んだことの記録' },
];
---

<nav class="cards" aria-label="サイト内の主なページ">
	{
		cards.map((card) => (
			<a href={card.href}>
				<span class="title">{card.title}</span>
				<span class="text">{card.text}</span>
			</a>
		))
	}
</nav>

<style>
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
		gap: 1rem;
	}

	/*
	  カード全体をリンクにする。中に押せる要素を入れ子にしない。

	  地の色は白のまま、影で面を浮かせている。塗りで区切ると本文より主張が強くなり、
	  トップの主役であるターミナルとぶつかる。
	*/
	.cards a {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.15rem 1.2rem 1.25rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: var(--radius);
		background: var(--bg);
		box-shadow: 0 1px 2px rgba(var(--black), 0.04);
		text-decoration: none;
		color: inherit;
		transition:
			transform 0.18s ease,
			box-shadow 0.18s ease,
			border-color 0.18s ease;
	}
	.cards a:hover {
		transform: translateY(-3px);
		border-color: var(--accent-light);
		box-shadow: 0 10px 24px rgba(var(--black), 0.09);
	}
	.cards a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.title {
		color: rgb(var(--black));
		font-size: 1.02rem;
		font-weight: 700;
		letter-spacing: 0.01em;
	}
	.cards a:hover .title {
		color: var(--accent);
	}

	.text {
		color: rgb(var(--gray));
		font-size: 0.82rem;
		line-height: 1.6;
	}

	/* 動きを減らす設定では浮かせない。色の変化だけ残す */
	@media (prefers-reduced-motion: reduce) {
		.cards a {
			transition: border-color 0.18s ease;
		}
		.cards a:hover {
			transform: none;
			box-shadow: 0 1px 2px rgba(var(--black), 0.04);
		}
	}
</style>
