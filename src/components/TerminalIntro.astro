---
import { SITE_TITLE } from '../consts';

/** ターミナルの中に出す行き先。select プロンプト風に並べる */
const choices = [
	{ href: '/profile', key: 'profile', text: 'プロフィールとスキル' },
	{ href: '/career', key: 'career', text: 'これまでの経歴' },
	{ href: '/blog', key: 'blog', text: '学んだことの記録' },
];
---

<div class="term" data-term tabindex="0" role="group" aria-label="サイトの案内">
	<div class="bar" aria-hidden="true">
		<span class="dots"><i></i><i></i><i></i></span>
		<span class="path">~/blog</span>
	</div>

	<div class="screen">
		<p class="cmd"><span data-typed>cat README.md</span><span class="cursor" data-cursor></span></p>

		<div class="out" data-out>
			<h1>{SITE_TITLE}</h1>
			<p>
				はじめまして、エンジニアの「てる」と申します。<br />
				エンジニアとしての経歴とスキル、日々学んだことの記録を置いています。<br />
				Astro+Vercel で構築しています。
			</p>

			<nav class="menu" aria-label="サイト内の主なページ" data-menu>
				<ul>
					{
						choices.map((choice) => (
							<li>
								<a href={choice.href}>
									<span class="marker" aria-hidden="true">
										❯
									</span>
									<span class="key">{choice.key}</span>
									<span class="text">{choice.text}</span>
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</div>
</div>

<script>
	/**
	 * ターミナル風のタイピング。
	 *
	 * 本文は最初から HTML に入れてある。JS で組み立てると、スクリプトが動かない
	 * 環境でトップページが空になり、検索エンジンにも中身が渡らないため。
	 * ここでやっているのは「いったん隠して、打ち直して見せる」だけ。
	 */
	function setupTerminal() {
		const term = document.querySelector<HTMLElement>('[data-term]');
		if (!term) return;

		const typed = term.querySelector<HTMLElement>('[data-typed]');
		const out = term.querySelector<HTMLElement>('[data-out]');
		const cursor = term.querySelector<HTMLElement>('[data-cursor]');
		if (!typed || !out || !cursor) return;

		// 動きを減らす設定なら、完成した状態のまま何もしない
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			cursor.classList.add('blink');
			return;
		}

		// 高さの確保は out を visibility: hidden にすることで足りている。
		// ここで offsetHeight を min-height に焼くと、Web フォントの読み込み前に
		// 測った高さがそのまま残り、フォント適用後に枠の下へ余白が出る。
		//
		// コマンド行は打ち終わるまで1行のままなので、これで画面は揺れない。

		const command = typed.textContent ?? '';
		typed.textContent = '';
		out.classList.add('is-hidden');

		let i = 0;
		const step = () => {
			typed.textContent = command.slice(0, ++i);
			if (i < command.length) {
				// 一定間隔だと機械的に見えるので、少しばらつかせる
				setTimeout(step, 45 + Math.random() * 55);
				return;
			}
			// 打ち終わってひと呼吸おいてから結果を出す
			setTimeout(() => {
				out.classList.remove('is-hidden');
				cursor.classList.add('blink');
			}, 320);
		};
		setTimeout(step, 400);
	}

	/**
	 * 選択肢を上下キーで移動できるようにする。
	 *
	 * 動かしているのは DOM の焦点そのもの。Enter は <a> の既定の動作が
	 * そのまま働くので、こちらでは何もしていない。
	 *
	 * ページのスクロールとは切り離してある。キーの既定の動作を止めるだけでは
	 * 足りず、focus() 側の自動スクロールも切る必要がある。
	 *
	 * キーを拾うのは焦点がターミナルの中にあるときだけ。ページ全体で拾うと
	 * 上下キーでのスクロールを奪ってしまう。
	 *
	 * 枠に tabindex を付けてあるので、カードをクリックするか Tab で入れば
	 * 行を選ばないうちから上下キーが効く。
	 */
	function setupMenu() {
		const term = document.querySelector<HTMLElement>('[data-term]');
		const menu = document.querySelector<HTMLElement>('[data-menu]');
		if (!term || !menu) return;

		const links = Array.from(menu.querySelectorAll('a'));
		if (links.length === 0) return;

		term.addEventListener('keydown', (event) => {
			const current = links.indexOf(document.activeElement as HTMLAnchorElement);

			// current が -1 なのは、まだ行を選んでいない状態（ターミナルの枠に焦点がある）。
			// 下キーなら既定の profile から、上キーなら末尾から入る
			let next: number;
			if (event.key === 'ArrowDown') {
				next = current === -1 ? 0 : (current + 1) % links.length;
			} else if (event.key === 'ArrowUp') {
				next = current === -1 ? links.length - 1 : (current - 1 + links.length) % links.length;
			} else {
				return;
			}

			// 上下キーの既定の動作（スクロール）を止める
			event.preventDefault();

			// focus() は既定で対象を画面内に送り込む。preventDefault では止まらないので、
			// ここで切っておかないと選択を動かすたびにページが動く
			links[next].focus({ preventScroll: true });
		});
	}

	setupTerminal();
	setupMenu();
</script>

<style>
	.term {
		border: 1px solid rgb(var(--gray-light));
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--bg);
	}
	/* キーボードで入ってきたときだけ枠を示す。クリックでは出さない */
	.term:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	/* 窓の上端。ネイビーにしてヘッダーと同じ世界のものに見せる */
	.bar {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.55rem 0.9rem;
		background: var(--navy);
	}
	.dots {
		display: flex;
		gap: 0.35rem;
	}
	.dots i {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.25);
	}
	.path {
		color: var(--header-fg-muted);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.75rem;
		letter-spacing: 0;
	}

	.screen {
		padding: 1.3rem 1.4rem 1.6rem;
	}

	.cmd {
		margin: 0;
		color: rgb(var(--gray-dark));
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.88rem;
		line-height: 1.7;
		letter-spacing: 0;
	}
	.cmd::before {
		content: '$ ';
		color: var(--accent-light);
		font-weight: 700;
	}

	.cursor {
		display: inline-block;
		width: 0.5em;
		height: 1em;
		margin-left: 0.1em;
		background: rgb(var(--gray));
		vertical-align: -0.15em;
	}
	.cursor.blink {
		animation: blink 1.05s steps(1, end) infinite;
	}

	.out {
		margin-top: 0.9rem;
	}
	.out h1 {
		margin: 0 0 0.5rem;
	}
	.out p {
		margin: 0;
		color: rgb(var(--gray));
	}
	/*
	  visibility で消す。display: none だと高さが失われ、
	  打ち込み中に下のコミットグラフが押し上げられてしまう
	*/
	.out.is-hidden {
		visibility: hidden;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	/* ---- 選択肢（select プロンプト風） ---- */

	.menu {
		margin-top: 1.4rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.86rem;
		/* 本文の行間のままだと間延びして端末の出力に見えない */
		line-height: 1.6;
		letter-spacing: 0;
	}
	.menu ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.menu a {
		display: grid;
		grid-template-columns: 1.2rem 6rem 1fr;
		align-items: baseline;
		padding: 0.2rem 0.3rem;
		border-radius: 4px;
		text-decoration: none;
		color: rgb(var(--gray));
	}

	/*
	  選択中の行の決め方。上から順に強い。

	  1. ポインタが乗っている行
	  2. 焦点がある行（ポインタがリストの外にあるときだけ）
	  3. どちらも無ければ先頭の profile

	  2 に :not(:hover) を付けてあるのが要で、これが無いと
	  「キーで選んだ行」と「マウスで指した行」の両方が光って二重に見える。
	*/
	.marker {
		color: var(--accent);
		opacity: 0;
	}

	/* 3. 誰も選んでいない間の既定 */
	.menu ul:not(:hover):not(:focus-within) li:first-child .marker {
		opacity: 1;
	}

	/* 2. 焦点で選ぶ。ポインタがリストに乗ったらマウスに譲る */
	.menu ul:not(:hover) a:focus-visible {
		background: var(--accent-soft);
	}
	.menu ul:not(:hover) a:focus-visible .marker {
		opacity: 1;
	}

	/* 1. ポインタで選ぶ */
	.menu a:hover {
		background: var(--accent-soft);
	}
	.menu a:hover .marker {
		opacity: 1;
	}

	.menu a:focus-visible {
		outline: none;
	}
	.key {
		color: rgb(var(--black));
		font-weight: 700;
	}
	.menu a:hover .key,
	.menu a:focus-visible .key {
		color: var(--accent);
	}
	.menu .text {
		font-size: 0.92em;
	}

	@media (max-width: 34rem) {
		.screen {
			padding: 1.1rem 1rem 1.3rem;
		}
		/* 幅が無いので説明は下に落とす */
		.menu a {
			grid-template-columns: 1.2rem 1fr;
		}
		.menu .text {
			grid-column: 2;
		}
	}
</style>
