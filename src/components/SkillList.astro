---
import { Icon } from 'astro-icon/components';
import { skillGroups } from '../data/skills';
---

<div class="groups">
	{
		skillGroups.map((group) => (
			<section class="group">
				<h3>{group.title}</h3>
				<ul>
					{group.items.map((skill) => (
						<li class="chip">
							{/* ロゴが無いスキルはテキストだけになる。高さと余白は変えない */}
							{skill.icon && (
								<Icon
									name={`simple-icons:${skill.icon}`}
									style={skill.color ? `color: ${skill.color}` : undefined}
									aria-hidden="true"
								/>
							)}
							<span>{skill.name}</span>
						</li>
					))}
				</ul>
			</section>
		))
	}
</div>

<style>
	/*
	  カードで囲わず、見出しとチップの並びだけで区切る。
	  枠を持たないぶん、区切りは見出しの字面と行間で作る。
	*/
	.groups {
		display: flex;
		flex-direction: column;
		gap: 1.9rem;
	}

	/* トップの「最近の記事」と同じ、控えめな見出しの体裁に合わせる */
	.group h3 {
		margin: 0 0 0.75rem;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: rgb(var(--gray));
	}

	.group ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.3rem 0.6rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		/* 地が白になったので、チップ側を薄く塗って形を出す */
		background: var(--bg-subtle);
		color: rgb(var(--gray-dark));
		font-size: 0.82rem;
		line-height: 1.4;
	}
	/* 色は skills.ts の color から currentColor 経由で入る */
	.chip [data-icon] {
		width: 1em;
		height: 1em;
		flex: none;
	}
</style>
