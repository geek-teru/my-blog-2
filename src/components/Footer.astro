---
const today = new Date();
---

<footer>
	<div class="inner">
		<a href="/rss.xml">RSS</a>
		<small>&copy; {today.getFullYear()} Teru</small>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid rgb(var(--gray-light));
	}
	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: var(--shell);
		max-width: calc(100% - 2.5rem);
		margin: 0 auto;
		padding: 1.5rem 0 2.5rem;
		color: rgb(var(--gray));
		font-size: 0.85rem;
	}
</style>
