---
import { CAREER } from '../data/career';
---

<div class="graph">
	{
		CAREER.map((branch, bi) => (
			<section class:list={['branch', { active: branch.current }]}>
				<header class="branch-head">
					<span class="node" aria-hidden="true" />
					<span class="branch-meta">
						{branch.current && <span class="head-ref">HEAD →</span>}
						<span class="branch-name">{branch.name}</span>
						<span class="branch-period">
							{branch.from} – {branch.to}
						</span>
					</span>
					<span class="branch-label">{branch.label}</span>
				</header>

				<ol class="commits">
					{branch.projects.map((project) => (
						<li>
							<span class="dot" aria-hidden="true" />
							<div class="commit">
								<p class="period">
									{project.from} – {project.to}
								</p>
								<h3>{project.title}</h3>

								<ul class="summary">
									{project.summary.map((bullet) =>
										typeof bullet === 'string' ? (
											<li>{bullet}</li>
										) : (
											<li>
												{bullet.text}
												<ul>
													{bullet.children.map((child) => (
														<li>{child}</li>
													))}
												</ul>
											</li>
										),
									)}
								</ul>

								{project.details.length > 0 && (
									<details>
										<summary>業務詳細</summary>
										<div class="detail-body">
											{project.details.map((group) => (
												<div class="detail-group">
													{group.heading && <h4>{group.heading}</h4>}
													<ul>
														{group.items.map((item) => (
															<li>{item}</li>
														))}
													</ul>
												</div>
											))}
										</div>
									</details>
								)}
							</div>
						</li>
					))}
				</ol>

				{/* 最後のブランチの下は線を止める。続きがあるように見せない */}
				{bi < CAREER.length - 1 && <div class="branch-gap" aria-hidden="true" />}
			</section>
		))
	}
</div>

<style>
	/*
	  トップのコミットグラフ（PostGraph）と同じ見立てを、経歴に当てている。
	  見出しの階層がそのまま対応する:
	    所属の期 = ブランチ / 案件 = コミット / 期間 = コミットの日付

	  丸と線はグリッドの1列目に置く。絶対配置だと基準の箱が行ごとに変わり、
	  線と丸の中心が噛み合わなくなる。
	*/
	.graph {
		--rail-col: 1.2rem;
		--gap: 1.1rem;
		--dot: 0.85rem;
	}

	.branch {
		position: relative;
		/* 進行中のブランチは水色、終わったブランチは落ち着いた紺 */
		--line: rgb(var(--gray-light));
		--mark: rgb(var(--gray));
	}
	.branch.active {
		--line: var(--accent-light);
		--mark: var(--accent-light);
	}

	/* ブランチ線。ブランチごとに1本引く */
	.branch::before {
		content: '';
		position: absolute;
		top: 0.55rem;
		bottom: 0;
		left: calc(var(--rail-col) / 2 - 1px);
		width: 2px;
		background: var(--line);
	}

	.branch-head,
	.commits > li {
		display: grid;
		grid-template-columns: var(--rail-col) minmax(0, 1fr);
		column-gap: var(--gap);
		align-items: start;
	}

	.branch-head {
		row-gap: 0.15rem;
		margin-bottom: 1.5rem;
	}
	.node {
		box-sizing: border-box;
		justify-self: center;
		width: 0.62rem;
		height: 0.62rem;
		margin-top: 0.42rem;
		border-radius: 999px;
		background: var(--mark);
	}
	.branch-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.82rem;
		letter-spacing: 0;
	}
	.head-ref {
		color: rgb(var(--gray));
	}
	.branch-name {
		padding: 0.05em 0.55em;
		border-radius: 999px;
		background: var(--mark);
		color: #fff;
		font-weight: 700;
	}
	.branch-period {
		color: rgb(var(--gray));
	}
	/* 2列目の2行目。ラベルは丸の列に食い込ませない */
	.branch-label {
		grid-column: 2;
		color: rgb(var(--gray-dark));
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.6;
	}

	.commits {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.commits > li {
		margin: 0;
		padding: 0 0 2.2rem;
	}

	/* コミットの丸。線の上に重ねるので地色で塗り、線を隠して節に見せる */
	.dot {
		box-sizing: border-box;
		justify-self: center;
		width: var(--dot);
		height: var(--dot);
		margin-top: 0.3rem;
		border: 2px solid var(--mark);
		border-radius: 999px;
		background: var(--bg);
	}

	.period {
		margin: 0;
		color: rgb(var(--gray));
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.78rem;
		line-height: 1.6;
		letter-spacing: 0;
	}
	.commit h3 {
		margin: 0.15rem 0 0.7rem;
		font-size: 1.05rem;
		line-height: 1.6;
	}

	.summary {
		margin: 0;
		padding-left: 1.2em;
		font-size: 0.92rem;
		line-height: 1.85;
	}
	.summary li {
		margin-bottom: 0.25em;
	}
	.summary ul {
		margin: 0.25em 0 0.4em;
		padding-left: 1.2em;
		color: rgb(var(--gray));
	}

	details {
		margin-top: 1rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: var(--radius);
		background: var(--bg-subtle);
	}
	summary {
		padding: 0.55rem 0.9rem;
		color: rgb(var(--gray-dark));
		font-size: 0.85rem;
		font-weight: 700;
		cursor: pointer;
		list-style: none;
	}
	/* 既定の三角を消して、自前の印を左に置く */
	summary::-webkit-details-marker {
		display: none;
	}
	summary::before {
		content: '▸';
		display: inline-block;
		margin-right: 0.5em;
		color: rgb(var(--gray));
		transition: transform 0.15s ease;
	}
	details[open] > summary::before {
		transform: rotate(90deg);
	}
	summary:hover {
		color: var(--accent);
	}
	.detail-body {
		padding: 0.2rem 0.9rem 1rem;
	}
	.detail-group + .detail-group {
		margin-top: 1.1rem;
	}
	.detail-group h4 {
		margin: 0 0 0.4rem;
		font-size: 0.88rem;
	}
	.detail-group ul {
		margin: 0;
		padding-left: 1.2em;
		color: rgb(var(--gray-dark));
		font-size: 0.88rem;
		line-height: 1.85;
	}
	.detail-group li {
		margin-bottom: 0.2em;
	}

	/* ブランチとブランチの間。線を一度切って、別の系列だと分かるようにする */
	.branch-gap {
		height: 1.6rem;
	}

	@media (max-width: 34rem) {
		.graph {
			--gap: 0.8rem;
		}
		.detail-body {
			padding: 0.2rem 0.7rem 0.9rem;
		}
	}
</style>
