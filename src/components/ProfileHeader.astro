---
import { Icon } from 'astro-icon/components';
import { PROFILE_MONOGRAM, SOCIAL_LINKS } from '../consts';
---

<div class="head">
	<!-- アバター画像は未用意。頭文字のモノグラムで代替している -->
	<div class="avatar" aria-hidden="true">{PROFILE_MONOGRAM}</div>

	<h2 class="name">Teru</h2>

	<ul class="links">
		{
			SOCIAL_LINKS.map((link) => (
				<li>
					{/* アイコンだけなので、読み上げ用の名前は aria-label で補う */}
					<a href={link.href} aria-label={link.label} title={link.label} rel="me noopener" target="_blank">
						<Icon name={`simple-icons:${link.icon}`} />
					</a>
				</li>
			))
		}
	</ul>

	<div class="bio">
		<p>はじめまして。</p>
		<p>フリーランスでインフラ・DevOps・バックエンドエンジニアをしている「てる」と申します。</p>
		<p>1994年生まれ、横浜在住、大阪生まれ育ち。</p>
		<p>学生時代にITの基礎やネットワークについて学び、新卒でSIerでインフラ系の部署にいました。</p>
		<p>
			現在はフリーランスエンジニアとして活動しております。<br />
			某WebサービスのSREを3年程やったり、某インターネット広告企業でプロダクトの立ち上げをしたりしました。
		</p>
		<p>最近は某インターネットメディア企業にてクレジットカード決済のシステムのAWS移行案件をやっています。</p>
	</div>
</div>

<style>
	.head {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.9rem;
		padding-bottom: 0.5rem;
	}

	/* ヘッダーと同じネイビーにして、サイト内の他の面と地続きに見せる */
	.avatar {
		display: grid;
		place-items: center;
		width: 5.5rem;
		height: 5.5rem;
		border-radius: 999px;
		background: var(--navy);
		color: var(--header-fg);
		font-size: 2.2rem;
		font-weight: 700;
		line-height: 1;
	}

	.name {
		margin: 0;
	}

	.links {
		display: flex;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.links a {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: var(--radius);
		color: rgb(var(--gray));
	}
	.links a:hover {
		background: var(--bg-subtle);
		color: rgb(var(--black));
	}
	.links [data-icon] {
		width: 1.15rem;
		height: 1.15rem;
	}

	/*
	  紹介文は複数段落あるので、.head の中央寄せから左寄せに戻す。
	  和文を中央寄せのまま折り返すと行頭が揃わず読み出しにくい。
	  align-items: center のままだと内容なりの幅で止まるので、
	  stretch で本文欄の幅いっぱいに広げる。
	*/
	.bio {
		align-self: stretch;
		text-align: left;
		color: rgb(var(--gray-dark));
	}
	.bio p {
		margin: 0 0 1em;
	}
	.bio p:last-child {
		margin-bottom: 0;
	}
</style>
