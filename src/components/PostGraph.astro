---
import FormattedDate from './FormattedDate.astro';
import Tags from './Tags.astro';
import type { Post } from '../lib/posts';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

{
	posts.length > 0 && (
		<div class="graph commit-graph">
			<p class="branch commit-row">
				<span class="node" aria-hidden="true" />
				<span class="branch-name">main</span>
			</p>

			<ol class="commits commit-list">
				{posts.map((post, i) => (
					<li class="commit-row" style={`--i:${i}`}>
						<span class="dot commit-dot" aria-hidden="true" />
						<a href={`/blog/${post.id}/`}>
							<span class="meta">
								<FormattedDate date={post.data.pubDate} />
								{post.data.draft && <span class="draft">下書き</span>}
							</span>
							<span class="title">{post.data.title}</span>
							{post.data.description && <span class="excerpt">{post.data.description}</span>}
							<Tags tags={post.data.tags} compact />
						</a>
					</li>
				))}
			</ol>
		</div>
	)
}

<style>
	/*
	  記事をコミットに見立てて縦のブランチ線に並べる。線と丸の見た目は
	  global.css の .commit-graph 側にあり、Career のグラフと共有している。
	  ここに置くのは、この画面でしか使わないものだけ。

	  作り話の情報は足していない。コミットハッシュ風の文字列を並べれば
	  それらしくはなるが、実在しない値を本物に見える形で出すことになるため。
	  線・丸・ブランチ名（実際に main で運用している）だけで見立てを作る。
	*/
	.branch {
		margin: 0 0 1.3rem;
	}
	.branch-name {
		color: rgb(var(--gray));
		font-size: 0.78rem;
		letter-spacing: 0.08em;
	}
	.node {
		justify-self: center;
		width: 0.5rem;
		height: 0.5rem;
		margin-top: 0.3rem;
		border-radius: 999px;
		background: rgb(var(--gray-light));
	}

	.commits > li {
		padding: 0 0 1.8rem;
	}
	.commits > li:last-child {
		padding-bottom: 0;
	}
	.commits a {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	/* 丸はリンクの外にあるので、行全体のホバーで拾う */
	.commits > li:hover .dot {
		border-color: var(--accent-light);
		background: var(--accent-light);
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		color: rgb(var(--gray));
		font-size: 0.78rem;
		line-height: 1.6;
	}
	/* dev でしか出ない。本番ビルドでは draft の記事自体が除外される */
	.draft {
		padding: 0.05em 0.5em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 4px;
		background: var(--bg-subtle);
	}
	.title {
		display: block;
		margin: 0.2rem 0 0.35rem;
		color: rgb(var(--black));
		font-size: 1.05rem;
		font-weight: 700;
		line-height: 1.6;
	}
	.commits > li:hover .title {
		color: var(--accent);
	}
	.excerpt {
		display: block;
		color: rgb(var(--gray));
		font-size: 0.88rem;
		line-height: 1.8;
	}
</style>
